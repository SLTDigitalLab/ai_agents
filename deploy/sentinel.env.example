# Copy to the repository root as .env.sentinel (git-ignored).
# This file is loaded only by Python backend code. For Docker use the matching
# compose override described in docs/SENTINEL_SETUP.md.
SENTINEL_GATEWAY_URL=https://sentinel.raccoon-ai.io
SENTINEL_GATEWAY_API_KEY=
SENTINEL_GATEWAY_MODEL=company-auto
SENTINEL_GUARDRAIL_MODEL=company-small
SENTINEL_GATEWAY_TIMEOUT_MS=130000
SENTINEL_GATEWAY_MAX_TOKENS=4096

# Enable text answers and the application's own classifier through Sentinel.
LLM_PROVIDER=sentinel
GUARDRAIL_PROVIDER=sentinel
SENTINEL_TOOL_PROVIDER=openai
# Keep your existing LLM_MODEL=gpt-5.4-mini, OPENAI_API_KEY (or LLM_API_KEY),
# and direct-provider LLM_BASE_URL in .env. Do not put company-auto in LLM_MODEL.

# Obtain the exact public embedding model and dimensions from the operator.
# Example: if the operator explicitly approves text-embedding-3-large at 3072,
# set those two values below. Blank values deliberately do not guess access.
SENTINEL_EMBEDDING_MODEL=
SENTINEL_EMBEDDING_DIMENSIONS=
SENTINEL_EMBEDDING_BATCH_SIZE=64
# Keep current query embeddings until the new collection has been built.
EMBEDDING_PROVIDER=openai
SENTINEL_STAGE_EMBEDDINGS=false
SENTINEL_COLLECTION_PREFIX=sentinel_v1_
SENTINEL_REUSE_EXISTING_VECTORS=false
CLEAR_QDRANT_BEFORE_INGEST=false

# Optional: set to sentinel after configuring/testing embeddings. This then
# uses the same approved model for routing profiles and routing queries.
ROUTING_EMBEDDING_PROVIDER=openai

# Multiple sequential model/tool calls can outlast one gateway request.
VOICE_CHAT_TIMEOUT_SECONDS=300
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# Do not change any SLM_* settings.
