# Copy to .env in this folder and fill in. 
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# On Linux production, set AIRFLOW_UID to the output of: id -u
FERNET_KEY=replace-with-generated-fernet-key

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Local only: extra pip packages on every container start.
# Prefer a custom Airflow image in production.
_PIP_ADDITIONAL_REQUIREMENTS=neo4j requests beautifulsoup4 python-dotenv

# Leave unset on a laptop so the DAG uses the mounted backend + /tmp JSON.
# On the production host, uncomment and adjust the compose file if needed:
# LIFESTORE_GRAPH_REFRESH_CMD=cd /opt/Ask_SLT && docker compose -f docker-compose.prod.yml exec -T backend python scripts/build_lifestore_graph.py
