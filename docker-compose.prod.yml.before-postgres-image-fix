name: workmate-staging

x-common: &common
  env_file:
    - ${WORKMATE_ENV_FILE:-/root/slt-app/.env}
  restart: unless-stopped
  networks:
    - workmate

services:
  postgres:
    <<: *common
    image: ${POSTGRES_IMAGE:-ankane/pgvector:latest}
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-slt}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-slt123}
      POSTGRES_DB: ${POSTGRES_DB:-slt_db}
    volumes:
      - ${WORKMATE_DATA_DIR:-/root/slt-app/data}/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 10

  qdrant:
    <<: *common
    image: ${QDRANT_IMAGE:-qdrant/qdrant:latest}
    volumes:
      - ${WORKMATE_DATA_DIR:-/root/slt-app/data}/qdrant:/qdrant/storage

  backend:
    <<: *common
    image: ${WORKMATE_BACKEND_IMAGE:-workmate-backend:local}
    build:
      context: .
      dockerfile: Dockerfile
      target: backend
    ports:
      - "127.0.0.1:${WORKMATE_BACKEND_PORT:-8100}:8000"
    depends_on:
      postgres:
        condition: service_healthy
      qdrant:
        condition: service_started
    environment:
      PYTHONUNBUFFERED: "1"
      POSTGRES_URL: postgresql://${POSTGRES_USER:-slt}:${POSTGRES_PASSWORD:-slt123}@postgres:5432/${POSTGRES_DB:-slt_db}
      QDRANT_URL: http://qdrant:6333
      LIFESTORE_MCP_TRANSPORT: streamable_http
      LIFESTORE_MCP_URL: http://mcp-lifestore:8001/mcp
      GOOGLE_APPLICATION_CREDENTIALS: /app/service-account.json
    volumes:
      - ${WORKMATE_DATA_DIR:-/root/slt-app/data}/evidence:/app/storage/evidence
      - ${GOOGLE_CREDENTIALS_FILE:-/root/slt-app/service-account.json}:/app/service-account.json:ro
    healthcheck:
      test: ["CMD", "python", "-c", "import socket; s=socket.create_connection(('127.0.0.1',8000),3); s.close()"]
      interval: 30s
      timeout: 5s
      start_period: 45s
      retries: 3

  mcp-lifestore:
    <<: *common
    image: ${WORKMATE_MCP_IMAGE:-workmate-mcp-lifestore:local}
    build:
      context: .
      dockerfile: Dockerfile
      target: mcp-lifestore
    depends_on:
      postgres:
        condition: service_healthy
      qdrant:
        condition: service_started
      backend:
        condition: service_healthy
    environment:
      MCP_TRANSPORT: streamable-http
      MCP_HOST: 0.0.0.0
      MCP_PORT: "8001"
      PYTHONPATH: /app/backend:/app
      QDRANT_URL: http://qdrant:6333
      ADMIN_BASE_URL: http://backend:8000
    volumes:
      - ${WORKMATE_DATA_DIR:-/root/slt-app/data}/real:/app/backend/data/real:ro

  frontend:
    <<: *common
    image: ${WORKMATE_FRONTEND_IMAGE:-workmate-frontend:local}
    build:
      context: ./frontend
    ports:
      - "127.0.0.1:${WORKMATE_FRONTEND_PORT:-3100}:3000"
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      start_period: 20s
      retries: 3

networks:
  workmate:
    name: workmate-staging
